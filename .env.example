# ==============================================================================
# Telegram Resume Analyzer - Environment Variables Template
# Copy this file to .env.local for local development or set in Vercel settings.
# NEVER commit actual secrets or API keys to version control.
# ==============================================================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Webhook Secret Token (recommended for Vercel production security)
# Generates a random alphanumeric secret (1-256 chars, A-Z, a-z, 0-9, _, -)
TELEGRAM_WEBHOOK_SECRET=

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional Gemini Model override (Default fallbacks: gemini-3.1-flash-lite, gemini-3.5-flash, gemini-2.0-flash)
GEMINI_MODEL=

# Production App URL (e.g., https://your-project.vercel.app)
# Used by setup scripts to register the Telegram webhook
NEXT_PUBLIC_APP_URL=
