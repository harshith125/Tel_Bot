# ==============================================================================
# Telegram Resume Analyzer - Environment Variables Template
# Copy this file to .env or set in Vercel settings.
# NEVER commit actual secrets or API keys to version control.
# ==============================================================================

# 1. Telegram Configuration
# Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Recommended for Vercel webhook security
TELEGRAM_WEBHOOK_SECRET=

# 2. Google Gemini AI Configuration
# API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
# Model name (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# 3. Google Drive Service Account / API Key
# Option A: Full Service Account JSON Key (as raw JSON string or base64 encoded string)
GOOGLE_SERVICE_ACCOUNT_KEY=
# Option B: Separate Service Account Email & Private Key
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Option C: API Key for public Google Drive links
GOOGLE_DRIVE_API_KEY=

# 4. Background Synchronization (Vercel Cron)
# Secret token to protect /api/cron/sync-drive
CRON_SECRET=

# 5. Production URL
NEXT_PUBLIC_APP_URL=
